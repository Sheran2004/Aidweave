# Local development only. Replace with real values before a public deployment.
APP_ENV=development
SECRET_KEY=local-development-only-change-this-value
DATABASE_URL=sqlite:///aidweave.db
SEED_DEMO=1
PORT=8000

# Local runs use the terminal for email links. Before launch, choose smtp or resend,
# and use a sender address/domain verified by that email service.
EMAIL_PROVIDER=console
PUBLIC_BASE_URL=http://localhost:8000
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=Aidweave <no-reply@example.org>
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=

# Set once in the hosting dashboard for the first administrator bootstrap.
BOOTSTRAP_ADMIN_TOKEN=
